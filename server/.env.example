PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:5180

# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/dms for local)
MONGO_URI=

# Long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# First admin account, created by `npm run seed`
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=change-me-123

# File storage: Backblaze B2 (leave empty to keep files in server/uploads)
# From Backblaze: bucket page "Endpoint", bucket name, and an Application Key (keyID + applicationKey)
B2_ENDPOINT=
B2_BUCKET=
B2_KEY_ID=
B2_APP_KEY=
